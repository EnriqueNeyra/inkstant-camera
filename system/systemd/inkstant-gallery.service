# Inkstant gallery (SPEC.md §13.3). Not enabled: the camera app starts it in share mode.
[Unit]
Description=Inkstant gallery
After=inkstant.service

[Service]
Type=exec
User=inkstant-web
Group=inkstant-web
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/inkstant/current
Environment=PYTHONPATH=/opt/inkstant/current/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m inkstant gallery 0.0.0.0:80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=96M
OOMScoreAdjust=500
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
